{
    "files": [],
    "compilerOptions": {
        "baseUrl": ".",
        "skipLibCheck": true,
        "composite": true,
        "noEmit": true,
        "paths": {
            "src/*": [
                "./src/*"
            ],
            "app/*": [
                "./src/app/*"
            ],
            "checklist/*": [
                "./src/checklist/*"
            ],
            "item-modal/*": [
                "./src/item-modal/*"
            ],
            "sortable-item/*": [
                "./src/sortable-item/*"
            ],
            "utilities/*": [
                "./src/utilities/*"
            ],
            "category-select/*": [
                "./src/category-select/*"
            ]
        }
    },
    "references": [
        {
            "path": "./tsconfig.app.json"
        },
        {
            "path": "./tsconfig.node.json"
        }
    ],
    "include": [
        "src",
        "tests"
    ],
    "exclude": [
        "node_modules",
        "dist",
        ".vitest"
    ]
}
