    "react-dom": "^19.2.0",
    "react-hook-form": "^7.73.1",
    "usehooks-ts": "^3.1.1",
    "uuid": "^14.0.0",
    "wouter": "^3.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
