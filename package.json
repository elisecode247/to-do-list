{
  "name": "daily-to-do",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "dev": "vite --port 5500",
    "build": "tsc -b && vite build && vite build --ssr src/prerender-entry.tsx --outDir .prerender && node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "type-check": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "start": "serve -s dist"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@headlessui/react": "^2.2.10",
    "@mdxeditor/editor": "^4.0.4",
    "@sentry/react": "^10.68.0",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.42.2",
    "lucide-react": "^0.559.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.82.0",
    "usehooks-ts": "^3.1.1",
    "uuid": "^14.0.1",
    "wouter": "^3.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "purgecss": "^8.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "serve": "^14.2.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
