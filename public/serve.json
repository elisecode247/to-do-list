{
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app-shell.html"
    },
    {
      "source": "/app/**",
      "destination": "/app-shell.html"
    },
    {
      "source": "/demo",
      "destination": "/app-shell.html"
    },
    {
      "source": "/theme-playground",
      "destination": "/app-shell.html"
    },
    {
      "source": "/settings",
      "destination": "/app-shell.html"
    },
    {
      "source": "/bulk-edit",
      "destination": "/app-shell.html"
    }
  ],
  "headers": [
    {
      "source": "**/*.@(avif|gif|ico|jpg|jpeg|png|svg|webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "assets/**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
